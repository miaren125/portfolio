---
import '../styles/global.css';
import { asset } from '../lib/asset';
const { title = 'Mia Renee Valenzuela Yescas · Portafolio' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Portafolio de Mia Renee Valenzuela Yescas / Portfolio" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Luxurious+Script&family=Cinzel:wght@500;700&family=Quicksand:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Idioma antes de pintar (evita parpadeo) -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var l = localStorage.getItem('lang') || (navigator.language || 'es').slice(0, 2);
        document.documentElement.lang = l === 'en' ? 'en' : 'es';
      } catch (e) {}
    </script>
  </head>
  <body><slot /></body>
</html>
