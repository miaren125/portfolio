---
import T from './T.astro';
import { about, hardSkills, softSkills, education, aspire } from '../data/content';
import { asset } from '../lib/asset';
const vars = `--bg:url(${asset('images/fondo-about.jpg')});--bg-m:url(${asset('images/fondo-about-m.jpg')})`;
---
<section id="about" class="sec sec-about" style={vars}>
  <div class="wrap">
    <!-- Fila 1: Descripción (más angosta) | Habilidades (más ancha) -->
    <div class="row row-a">
      <article class="box glass">
        <h2><T es="Descripción" en="About me" /></h2>
        <p><T es={about.who.es} en={about.who.en} /></p>
        <p><T es={about.can.es} en={about.can.en} /></p>
        <a class="btn glass" href={asset(about.cv)} download><T es="CV descargable" en="Download CV" /></a>
      </article>

      <article class="box glass">
        <h2><T es="Habilidades" en="Skills" /></h2>
        <div class="skills">
          <div>
            <h3>Hard skills</h3>
            <ul class="bars">
              {hardSkills.map((s) => (
                <li>
                  <span>{s.name}</span><b>{s.level}%</b>
                  <div class="track"><div class="fill" style={`--w:${s.level}%`}></div></div>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Soft skills</h3>
            <ul class="chips">
              {softSkills.map((s) => <li><T es={s.es} en={s.en} /></li>)}
            </ul>
          </div>
        </div>
      </article>
    </div>

    <!-- Fila 2: Educación (más angosta) | Puestos a los que aspiro (más ancha) -->
    <div class="row row-b">
      <article class="box glass">
        <h2><T es="Educación" en="Education" /></h2>
        <ul class="timeline">
          {education.map((e) => (
            <li>
              <strong><T es={e.title.es} en={e.title.en} /></strong><br />
              <T es={e.place.es} en={e.place.en} /><br />
              <small>{e.years}</small>
            </li>
          ))}
        </ul>
      </article>
      <article class="box glass">
        <h2><T es="Puestos a los que aspiro" en="Positions I aim for" /></h2>
        <ul class="chips">
          {aspire.map((a) => <li><T es={a.es} en={a.en} /></li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<script>
  // Las barras se llenan cuando entran en pantalla
  const fills = document.querySelectorAll<HTMLElement>('.fill');
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.4 },
  );
  fills.forEach((f) => io.observe(f));
</script>
