---
import T from './T.astro';
import { asset } from '../lib/asset';
import type { Project } from '../data/projects';
interface Props { p: Project }
const { p } = Astro.props;
const photos = p.photos?.length ? p.photos : [p.cover];
---
<dialog class="pm" id={`m-${p.id}`} aria-labelledby={`t-${p.id}`}>
  <button class="pm-close glass" data-close aria-label="Cerrar / Close" type="button">×</button>
  <div class="pm-grid">
    <!-- Columna izquierda: nombre, qué es, tecnologías -->
    <div class="pm-col">
      <h2 id={`t-${p.id}`}><T es={p.name.es} en={p.name.en} /></h2>
      {p.what && (
        <section class="pm-box"><h3><T es="¿Qué es el proyecto y en qué participé?" en="What is it and what did I do?" /></h3>
          <p><T es={p.what.es} en={p.what.en} /></p></section>
      )}
      {p.desc && (
        <section class="pm-box"><h3><T es="Descripción" en="Description" /></h3>
          <p><T es={p.desc.es} en={p.desc.en} /></p></section>
      )}
      {p.req && (
        <section class="pm-box"><h3><T es="Requerimientos del cliente" en="Client requirements" /></h3>
          <p><T es={p.req.es} en={p.req.en} /></p></section>
      )}
      {p.tech && (
        <section class="pm-box"><h3><T es="¿Qué tecnologías usé?" en="Which technologies did I use?" /></h3>
          <ul class="dots">{p.tech.map((t) => <li>{t}</li>)}</ul></section>
      )}
    </div>

    <!-- Columna derecha: fotos, key features / diseño-implementación-resultado, repo -->
    <div class="pm-col">
      <div class="gallery-wrap">
        <div class="gallery" tabindex="0" aria-label="Fotos del proyecto / Project photos">
          {photos.map((src) => <div class="slide" style={`--img:url(${asset(src)})`}></div>)}
        </div>
        {photos.length > 1 && (
          <>
            <button class="g-btn glass prev" data-dir="-1" type="button" aria-label="Anterior / Previous">‹</button>
            <button class="g-btn glass next" data-dir="1" type="button" aria-label="Siguiente / Next">›</button>
          </>
        )}
      </div>
      {p.features && (
        <section class="pm-box"><h3>Key features</h3>
          <ul class="feat">{p.features.map((f) => <li><T es={f.es} en={f.en} /></li>)}</ul></section>
      )}
      {p.design && (
        <section class="pm-box"><h3><T es="¿Cómo se diseñó la solución?" en="How was the solution designed?" /></h3>
          <p><T es={p.design.es} en={p.design.en} /></p></section>
      )}
      {p.impl && (
        <section class="pm-box"><h3><T es="¿Cómo se implementó la solución?" en="How was it implemented?" /></h3>
          <p><T es={p.impl.es} en={p.impl.en} /></p></section>
      )}
      {p.result && (
        <section class="pm-box"><h3><T es="¿Cuál fue el resultado?" en="What was the result?" /></h3>
          <p><T es={p.result.es} en={p.result.en} /></p></section>
      )}
      {p.repo && <a class="btn glass" href={p.repo} target="_blank" rel="noopener"><T es="Ver repositorio" en="View repository" /></a>}
    </div>
  </div>
</dialog>
