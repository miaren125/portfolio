---
import T from './T.astro';
import ProjectModal from './ProjectModal.astro';
import { projects } from '../data/projects';
import { asset } from '../lib/asset';
const vars = `--bg:url(${asset('images/folders.jpg')});--bg-m:url(${asset('images/folders-m.jpg')})`;
---
<section id="proyectos" class="sec sec-proj" style={vars}>
  <div class="wrap">
    <div class="folder-top">
      <div class="folder-tabs" role="tablist">
        <button role="tab" class="tab glass active" data-tab="tech" aria-selected="true" type="button">Tech</button>
        <button role="tab" class="tab glass" data-tab="arte" aria-selected="false" type="button"><T es="Arte" en="Art" /></button>
      </div>
      <div class="pager">
        <span class="hint"><T es="picar para pasar página" en="click to turn the page" /></span>
        <button class="pager-btn glass" id="prevPage" type="button" aria-label="Página anterior / Previous page">‹</button>
        <span id="pageInfo" aria-live="polite">1 / 1</span>
        <button class="pager-btn glass" id="nextPage" type="button" aria-label="Página siguiente / Next page">›</button>
      </div>
    </div>

    <div class="folder glass">
      <div class="cards" id="cards" data-size="4">
        {projects.map((p) => (
          <article class="card" data-cat={p.category}>
            <div class="thumb" style={`--img:url(${asset(p.cover)})`}></div>
            <div class="info">
              <span class="type">
                {p.repo ? <T es="Repositorio" en="Repository" /> : <T es="Blog" en="Blog" />}
              </span>
              <h3><T es={p.name.es} en={p.name.en} /></h3>
              <button class="btn glass" type="button" data-open={`m-${p.id}`}><T es="Detalles" en="Details" /></button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  {projects.map((p) => <ProjectModal p={p} />)}
</section>

<script>
  import '../scripts/projects';
</script>
