---
import T from './T.astro';
import { profile, contacts } from '../data/content';
import { asset } from '../lib/asset';
const heroVars = `--bg:url(${asset('images/laptop.jpg')});--bg-m:url(${asset('images/laptop-m.jpg')})`;
---
<section id="home" class="hero" style={heroVars}>
  <div class="hero-stage">
    <div class="hero-folder" style={`--folder:url(${asset('images/folder-hola.png')})`}>
      <p><T es="¡Hola! soy:" en="Hi! I'm:" /></p>
      <h1 set:html={profile.name.join('<br>')} />
      <p class="role"><T es={profile.role.es} en={profile.role.en} /></p>
    </div>
  </div>

  <div class="lanyard" id="lanyard">
    <svg class="strings" aria-hidden="true"><line id="s1" /><line id="s2" /></svg>
    <div class="badge glass" id="badge" tabindex="0" aria-label="Gafete interactivo: arrástralo / Interactive badge: drag it">
      <span class="clip"></span>
      <div class="photo" style={`--photo:url(${asset('images/mia.jpg')})`}></div>
    </div>
    <ul class="socials">
      <li><a class="glass" href={contacts.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">in</a></li>
      <li><a class="glass" href={`mailto:${contacts.email}`} aria-label="Email">@</a></li>
      <li><a class="glass" href={contacts.github} target="_blank" rel="noopener" aria-label="GitHub">gh</a></li>
    </ul>
  </div>

  <a href="#about" class="scroll glass" aria-label="Seguir bajando / Scroll down">↓</a>
</section>

<script>
  import '../scripts/lanyard';
</script>
